OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=verse
OPENAI_TTS_SPEED=1.03
OPENAI_TTS_INSTRUCTIONS=You are a high-retention YouTube science narrator. Sound warm, curious, and engaging, with varied pace and emphasis. Use natural pauses, slight excitement on surprising points, and avoid flat monotone delivery.
VOICE_PROVIDER=openai
PEXELS_API_KEY=
AUTO_FETCH_STOCK=true
STOCK_MIN_VIDEOS=10
STOCK_MIN_IMAGES=20
TOPIC_STOCK_MIN_VIDEOS=4
TOPIC_STOCK_MIN_IMAGES=8
PEXELS_VIDEOS_PER_FETCH=4
PEXELS_IMAGES_PER_FETCH=6
PEXELS_TIMEOUT_SECONDS=30
RUN_PROFILE=production
VIDEO_OVERLAY_TEXT_ENABLED=true
CHANNEL_NAME=Curiosity Signal
CHANNEL_INTRO_ENABLED=true
CHANNEL_INTRO_TEXT=Welcome to another video from Curiosity Signal, your home of fascinating science content.

TIMEZONE=UTC
SCHEDULE_HOUR=10
SCHEDULE_MINUTE=0
RUN_ONCE_ON_START=false
AUTO_SCHEDULE_UPLOAD=true
PUBLISH_DAYS_AHEAD=1

VIDEO_SECONDS_MIN=120
VIDEO_SECONDS_MAX=240
MAX_GENERATION_RETRIES=2
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
VIDEO_FPS=24
VIDEO_PRESET=medium

OUTPUT_DIR=output
TEMP_DIR=output/temp
LOGS_DIR=logs
STATE_DIR=state
ASSETS_DIR=assets
STOCK_FOOTAGE_DIR=assets/stock
SECRETS_DIR=secrets
TOPIC_HISTORY_FILE=state/topic_history.json
SCRIPT_ARCHIVE_FILE=state/script_archive.jsonl
PENDING_JOB_FILE=state/pending_job.json

YOUTUBE_CREDENTIALS_FILE=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/token.json
YOUTUBE_CATEGORY_ID=27
DEFAULT_TAGS=science facts,world facts,interesting facts,educational videos,curiosity

DRY_RUN=true
